      "seed": 2072586096,
      "version": 770,
      "versionNonce": 2134379509,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781614599067,
      "link": null,
      "locked": false,
      "text": "EHandling\nSystem for generating maintenance routes for hundreds of cargoes to laydown areas in FPSOs.\nManual routing studies cost ~200k USD, modelling mistakes can add up to millions of USD.\n\nFunctional Requirements:\n- Users can upload huge 3DModels\n- Detect relevant elements in the model\n- Calculate routes for cargoes\n- Visualize routes\n\nNon-Functional Requirements:\n- Support models with billions of triangles (50+ GB)\n- Fast route calculation for hundreds of cargoes\n\nSide-features\n- Handling Bot\n- Ergonomic access eval\n- Dropped objects",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "EHandling\nSystem for generating maintenance routes for hundreds of cargoes to laydown areas in FPSOs.\nManual routing studies cost ~200k USD, modelling mistakes can add up to millions of USD.\n\nFunctional Requirements:\n- Users can upload huge 3DModels\n- Detect relevant elements in the model\n- Calculate routes for cargoes\n- Visualize routes\n\nNon-Functional Requirements:\n- Support models with billions of triangles (50+ GB)\n- Fast route calculation for hundreds of cargoes\n\nSide-features\n- Handling Bot\n- Ergonomic access eval\n- Dropped objects",
      "autoResize": true,
      "lineHeight": 1.25
    },
