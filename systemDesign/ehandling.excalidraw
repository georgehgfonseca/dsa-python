    {
      "id": "jyDraGs4ZL3wIKFDsyiZb",
      "type": "text",
      "x": 1005.2886035105452,
      "y": -624.4986634154957,
      "width": 1304.29541015625,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
