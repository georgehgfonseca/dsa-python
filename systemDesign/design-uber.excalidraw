      "link": null,
      "locked": false,
      "text": "Keep locations updated with at most 1 second delay\nRide match search should be processed under 10 seconds\nA ride cannot be accepted by more than one driver (unless cancelled)\nHandle traffic surges and bursts ",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 91,
      "containerId": null,
      "originalText": "Keep locations updated with at most 1 second delay\nRide match search should be processed under 10 seconds\nA ride cannot be accepted by more than one driver (unless cancelled)\nHandle traffic surges and bursts ",
