    },
    {
      "id": "sV4gBFlYpn55MftAXU_n7",
      "type": "text",
      "x": -4172.662934318422,
      "y": -1261.7870880949013,
      "width": 1078.125,
      "height": 144,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1948801932,
      "version": 657,
      "versionNonce": 1543278260,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782913250394,
      "link": null,
      "locked": false,
      "text": "1. Riders should be able to input a start location and a destination and get a fare estimate\n2. Riders should be able to request a ride based on the estimated fare\n3. Drivers should be able to accept/decline a request and navigate to pickup/drop-off\n\nSystem Scale\n- 100M daily active users, 15M rides per day",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 91,
      "containerId": null,
      "originalText": "1. Riders should be able to input a start location and a destination and get a fare estimate\n2. Riders should be able to request a ride based on the estimated fare\n3. Drivers should be able to accept/decline a request and navigate to pickup/drop-off\n\nSystem Scale\n- 100M daily active users, 15M rides per day",
      "lineHeight": 1.2,
      "index": "b8A",
      "autoResize": true
    },
    {
      "id": "ezaI2_wHcdRju7CEztRqo",
      "type": "text",
      "x": -4211.725434318422,
      "y": -1607.9537547615678,
      "width": 2171.3994140625,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8B",
      "roundness": null,
      "seed": 1049063860,
      "version": 485,
      "versionNonce": 578702772,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782913373665,
      "link": null,
      "locked": false,
      "text": "Uber is a ride-sharing platform that connects passengers with drivers who offer transportation services in personal vehicles. It allow users \nto book rides on-demand from their smartphones, matching them with a nearby driver who will take them from their location\nto their desired destination. When the system finds a match, it sends an update to the driver asking them to\naccept of decline the ride.",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Uber is a ride-sharing platform that connects passengers with drivers who offer transportation services in personal vehicles. It allow users \nto book rides on-demand from their smartphones, matching them with a nearby driver who will take them from their location\nto their desired destination. When the system finds a match, it sends an update to the driver asking them to\naccept of decline the ride.",
